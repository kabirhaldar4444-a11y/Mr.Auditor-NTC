# Supabase Credentials Configuration Template
# Duplicate this file to '.env' and fill in your actual project values.

# Your Supabase Project URL (can be found in Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Public Anon Key (can be found in Project Settings -> API)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Google Gemini API Key (starts with AQ. or AIzaSy...)
VITE_GEMINI_API_KEY=your-gemini-api-key
